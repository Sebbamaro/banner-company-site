Options -Indexes
DirectoryIndex index.html
ErrorDocument 404 /404.html
<IfModule mod_headers.c>
 Header always set X-Content-Type-Options "nosniff"
 Header always set Referrer-Policy "no-referrer"
 Header always set X-Frame-Options "DENY"
 Header always set Content-Security-Policy "default-src 'self'; script-src 'self' https://mc.yandex.ru; connect-src 'self' https://mc.yandex.ru https://mc.yandex.com; img-src 'self' data: https://mc.yandex.ru; style-src 'self'; frame-ancestors 'none'; base-uri 'self'; form-action 'self'"
</IfModule>
